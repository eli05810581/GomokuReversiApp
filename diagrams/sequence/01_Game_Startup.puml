
@startuml
title 01 - Game Startup and Factory Creation
autonumber

actor Player
participant Program
participant "CommandLineParser" as CL
participant "GameFactorySelector" as Selector
participant "IGameFactory\n(selected concrete factory)" as Factory
participant "ICommandSource" as Source
participant Game

note right of Selector
  Concrete Factories (6):

  Gomoku:
  - GomokuStandardGameFactory
  - GomokuPlusGameFactory
  - GomokuFogGameFactory

  Reversi:
  - ReversiStandardGameFactory
  - ReversiAntiGameFactory
  - ReversiCornerGameFactory
end note

note right of Factory
  Interface:
  IGameFactory

  Abstract Classes (3):
  - GameFactoryBase
  - GomokuFactoryBase
  - ReversiFactoryBase

  GameFactoryBase provides
  shared CreateGame() logic.

  GomokuFactoryBase and
  ReversiFactoryBase provide
  family-specific configuration.
end note

alt Command-line arguments supplied
    Program -> CL : Parse(args)
    CL --> Program : LaunchConfiguration
else Interactive menu
    Player -> Program : Choose New Game
    Program -> Program : ConfigureNewGame()
end

Program -> Program : CreateGame(config)
Program -> Selector : Create(config.Variant)
Selector --> Program : IGameFactory
Program -> Factory : CreateGame(config)

group GameFactoryBase.CreateGame()
    Factory -> Factory : CreateBoard()
    Factory -> Factory : CreatePlayers(config.GameMode, config.AIDifficulty)
    Factory -> Factory : CreateMoveParser()
    Factory -> Factory : CreateMoveProcessor()
    Factory -> Factory : CreateGameOverChecker()
    Factory -> Factory : CreateVisibilityModel()
    Factory -> Factory : CreateHelpProvider()

    group CreateCommandSource(config, moveParser)
        Factory -> Factory : CreateCommandSource(config, moveParser)

        alt Interactive GameMode
            Factory -> Source : new InteractiveCommandSource(...)
        else Automated GameMode
            Factory -> Source : new AutomatedCommandSource(...)
        end

        Source --> Factory : ICommandSource
    end

    Factory -> Game ** : new Game(config, board, players,\nmoveParser, moveProcessor,\ngameOverChecker, visibilityModel,\nhelpProvider, commandSource)
    Game --> Factory : game
end

Factory --> Program : Game
Program -> Program : RunGameSession(game)
Program -> Game : PlayGame()

@enduml
