
@startuml
title Object Diagram 2 - GomokuPlus Loaded Game
left to right direction
skinparam shadowing false
skinparam linetype ortho

object "game : Game" as game {
  TurnCount = 6
  Result = Ongoing
}

object "config : LaunchConfiguration" as config {
  GameType = Gomoku
  Variant = GomokuPlus
  GameMode = HumanVsHuman
}

object "player1 : HumanPlayer" as p1 {
  Name = Player1
  Number = 1
}

object "player2 : HumanPlayer" as p2 {
  Name = Player2
  Number = 2
}

object "inventory1 : Inventory" as inv1 {
  Heavy = 1
  Eraser = 2
}

object "inventory2 : Inventory" as inv2 {
  Heavy = 2
  Eraser = 1
}

object "board : Board" as board {
  Rows = 10
  Cols = 10
}

object "processor : GomokuPlusMoveProcessor" as processor
object "saved : SavedGameData" as saved
object "snapshot : GameState" as snapshot
object "undo : List<GameState>" as undo
object "redo : List<GameState>" as redo

game --> config : Configuration
game --> p1 : Players[0]
game --> p2 : Players[1]
game --> board : Board
game --> processor : MoveProcessor

p1 --> inv1 : Inventory
p2 --> inv2 : Inventory

saved --> config : Configuration
saved --> snapshot : CurrentState
saved --> undo : UndoHistory
saved --> redo : RedoHistory

game ..> snapshot : Restored state

note bottom of saved
Save data contains the
game configuration,
current state, and
undo/redo histories.
end note
@enduml
